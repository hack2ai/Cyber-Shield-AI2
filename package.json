    "html2canvas": "^1.4.1",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.378.0",
    "motion": "^11.2.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.3.0",
    "tsx": "^4.21.0",
    "whois-json": "^2.0.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
