{
  "name": "cyber-shield-ai",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "npx tsx server.ts",
    "build": "vite build && npx esbuild server.ts --bundle --platform=node --format=esm --outfile=dist/server.js --external:express --external:@google/generative-ai --external:dotenv --external:vite --external:whois-json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/generative-ai": "^0.11.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.1",
    "firebase": "^12.13.0",
    "html2canvas": "^1.4.1",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.378.0",
    "motion": "^11.2.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.3.0",
    "tsx": "^4.21.0",
    "whois-json": "^2.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.1",
    "esbuild": "^0.28.2",
    "globals": "^16.5.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.4.5",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "@grpc/grpc-js": ">=1.10.0",
    "body-parser": ">=1.20.6",
    "esbuild": "^0.28.2",
    "ip-address": ">=10.3.1",
    "nanoid": ">=3.3.18",
    "protobufjs": ">=7.6.5",
    "qs": ">=6.15.2",
    "websocket-driver": ">=0.7.5"
  }
}
